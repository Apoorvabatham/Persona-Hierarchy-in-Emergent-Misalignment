\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Evaluation framing across 26 role clusters.} Positive means the framing \emph  {raised} misalignment. All three contrasts survive Benjamini--Hochberg correction. The primary contrast is positive, meaning the model is \emph  {more} misaligned once it is told it is being evaluated on alignment, which is the opposite of what evaluation gaming would predict.}}{6}{figure.caption.15}\protected@file@percent }
\newlabel{fig:eval01}{{3}{6}{\textbf {Evaluation framing across 26 role clusters.} Positive means the framing \emph {raised} misalignment. All three contrasts survive Benjamini--Hochberg correction. The primary contrast is positive, meaning the model is \emph {more} misaligned once it is told it is being evaluated on alignment, which is the opposite of what evaluation gaming would predict}{figure.caption.15}{}}
