\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The role-specific misalignment profile is highly consistent across model sizes} (all-cells $r = 0.877$, role-mean $r = 0.913$), with \texttt  {\small  hacker} showing the largest increase. Some roles are systematically more prone to emergent misalignment. The typed-distance results show no hierarchical pattern, so these differences are better explained by one broad susceptibility axis than by parent-child role relationships.}}{4}{figure.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:scale}{{1}{4}{\textbf {The role-specific misalignment profile is highly consistent across model sizes} (all-cells $r = 0.877$, role-mean $r = 0.913$), with \code {hacker} showing the largest increase. Some roles are systematically more prone to emergent misalignment. The typed-distance results show no hierarchical pattern, so these differences are better explained by one broad susceptibility axis than by parent-child role relationships}{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {An intervention meant to remove the amplifying persona raised misalignment instead}, in 22 of 26 roles. The weights are identical in every arm, and only the appended sentence differs. The general-priming worry turns out to be empty, since \texttt  {\small  safety} $-$ baseline spans zero.}}{4}{table.caption.9}\protected@file@percent }
\newlabel{tab:arm01}{{1}{4}{\textbf {An intervention meant to remove the amplifying persona raised misalignment instead}, in 22 of 26 roles. The weights are identical in every arm, and only the appended sentence differs. The general-priming worry turns out to be empty, since \code {safety} $-$ baseline spans zero}{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}The intervention ran backwards}{4}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Other explanations, tested and ruled out.}{4}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}The backfire replicates across seven wordings, and the obvious fix backfires too}{4}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Mechanism: negating a persona installs it.} Share of responses containing hacker vocabulary, pooled over 26 roles, by arm. Baseline and \texttt  {\small  safety} are flat, \texttt  {\small  anti\_hacker} more than quadruples the share, and \texttt  {\small  anti\_painter} (the same template aimed at a different persona) does not. Dropping any single word from the list moves the ratio only between $\times $3.09 and $\times $4.25, and the word lists were frozen before the painter numbers were computed.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:vocab}{{2}{5}{\textbf {Mechanism: negating a persona installs it.} Share of responses containing hacker vocabulary, pooled over 26 roles, by arm. Baseline and \code {safety} are flat, \code {anti\_hacker} more than quadruples the share, and \code {anti\_painter} (the same template aimed at a different persona) does not. Dropping any single word from the list moves the ratio only between $\times $3.09 and $\times $4.25, and the word lists were frozen before the painter numbers were computed}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Six of seven wordings raised EM, and none lowered it significantly.} 5 roles, 200 generations per cell, \texttt  {\small  safety} as the comparator, corrected across the family of seven. The replication (\texttt  {\small  anti\_hacker}, $+12.05$\,pp) matches \texttt  {\small  arm01}'s $+10.79$\,pp{} on a different role set.}}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:screen01}{{2}{5}{\textbf {Six of seven wordings raised EM, and none lowered it significantly.} 5 roles, 200 generations per cell, \code {safety} as the comparator, corrected across the family of seven. The replication (\code {anti\_hacker}, $+12.05$\pp ) matches \code {arm01}'s $+10.79$\pp {} on a different role set}{table.caption.12}{}}
