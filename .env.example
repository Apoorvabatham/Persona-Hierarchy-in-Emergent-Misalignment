# Copy to .env and fill in your own values. Never commit the real .env.

# Ollama Cloud keys for the EM judge (src/judge.py, scripts/run_judge.py).
# One key per line, numbered contiguously from 1; src/utils.py pools them
# across concurrent requests. At least one is required.
OLLAMA_API_KEY1=
OLLAMA_MODEL=

# Hugging Face token, needed by src/em_roles/ to pull the ModelOrganismsForEM
# adapters and base Qwen2.5 checkpoints. Not needed for judging/analysis only.
HUGGINGFACE_API_TOKEN=
